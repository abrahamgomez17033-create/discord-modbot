# Discord Bot Token (OBLIGATORIO)
# Obtén el token en: https://discord.com/developers/applications
TOKEN=tu_token_aqui

# Prefijo de comandos (opcional, default: !)
PREFIX=!

# ID del canal de logs (opcional)
LOG_CHANNEL_ID=

# Nombre del rol de mute (opcional, default: Muted)
MUTE_ROLE_NAME=Muted

# Nombre de la categoría de tickets (opcional, default: Tickets)
TICKET_CATEGORY_NAME=Tickets

# Roles de staff separados por comas (opcional, default: Admin,Mod,Staff)
STAFF_ROLES=Admin,Mod,Staff

# Puerto HTTP para healthcheck (Render lo asigna automáticamente)
PORT=10000